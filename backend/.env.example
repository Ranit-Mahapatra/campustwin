# Django Environment Variables Configuration Template
# Copy this file to backend/.env (gitignored) and set real values locally.
# Never commit real secrets.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL=True
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
